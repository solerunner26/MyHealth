    <string name="insights_title">What to focus on</string>
    <string name="insights_intro">These points are found by fixed rules from your saved values. They are a starting point for a conversation with your doctor, not a diagnosis.</string>
    <string name="insights_none_title">Nothing to flag right now</string>
    <string name="insights_none_body">No rule found anything to raise in the saved records. Keep adding reports and vitals so changes are noticed.</string>
    <string name="insights_why">Why this appears</string>
    <string name="insights_hide">Hide details</string>
    <string name="insights_evidence">Evidence</string>
    <string name="insights_open_trend">Open trend</string>
    <string name="rule_range">Rule: the latest result is compared with the reference range printed on the report (or a typical adult range when none is printed).</string>
    <string name="rule_rapid">Rule: the change per month between the last two results is above the usual threshold for this test, in the less healthy direction.</string>
    <string name="rule_overdue">Rule: the last test is older than the usual re-test interval for this test.</string>
    <string name="rule_vital">Rule: the latest reading in the past 90 days falls outside the typical adult band.</string>
    <string name="rule_gap">Rule: no recent record of this kind was found.</string>
    <string name="rule_medicine">Rule: based on your medicine list and the doses marked in reminders.</string>
    <string name="rule_followup">Rule: a follow-up date on a treatment is close or has passed.</string>
    <string name="rule_wearable">Rule: this week\'s daily average from Health Connect is compared with the four weeks before.</string>
    <string name="score_breakdown">How the health score is worked out</string>
    <string name="score_explain">The score combines four parts. Parts without data are left out and the others are scaled up, so missing information never counts for or against you. No score is shown when less than 40%% of the information is available.</string>
