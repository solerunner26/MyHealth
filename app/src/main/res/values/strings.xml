    <!-- Focus items: title + explanation, filled from FocusItem.args -->
    <string name="focus_value_high_title">%1$s is above range</string>
    <string name="focus_value_high_body">Your latest %1$s was %2$s %3$s; the reference range is %4$s. One reading is a snapshot — repeat it before drawing conclusions.</string>
    <string name="focus_value_low_title">%1$s is below range</string>
    <string name="focus_value_low_body">Your latest %1$s was %2$s %3$s; the reference range is %4$s. Low values can have simple causes, so rechecking is worthwhile.</string>
    <string name="focus_value_critical_high_title">%1$s is well above range</string>
    <string name="focus_value_critical_high_body">Your latest %1$s was %2$s %3$s. A result this far from the reference range (%4$s) deserves a prompt conversation with a doctor.</string>
    <string name="focus_value_critical_low_title">%1$s is well below range</string>
    <string name="focus_value_critical_low_body">Your latest %1$s was %2$s %3$s, far below the reference range (%4$s). Please discuss this with a doctor soon.</string>
    <string name="focus_back_in_range_title">%1$s is back in range</string>
    <string name="focus_back_in_range_body">Your latest %1$s is %2$s %3$s, inside the reference range again. Whatever you changed seems to be working.</string>
    <string name="focus_trend_rising_title">%1$s is rising</string>
    <string name="focus_trend_rising_body">%1$s has moved from %2$s to %3$s over %4$s months, a %5$s%% change.</string>
    <string name="focus_trend_falling_title">%1$s is falling</string>
