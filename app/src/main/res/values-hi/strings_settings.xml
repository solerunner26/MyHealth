    <string name="rule_range">नियम: ताज़ा नतीजे की तुलना रिपोर्ट पर छपी सामान्य रेंज से (या न होने पर सामान्य वयस्क रेंज से) की जाती है।</string>
    <string name="rule_rapid">नियम: पिछले दो नतीजों के बीच हर महीने का बदलाव इस जाँच की सामान्य सीमा से ज़्यादा है, कम स्वस्थ दिशा में।</string>
    <string name="rule_overdue">नियम: आख़िरी जाँच इस जाँच की सामान्य दोबारा-जाँच अवधि से पुरानी है।</string>
    <string name="rule_vital">नियम: पिछले 90 दिनों का आख़िरी माप सामान्य वयस्क दायरे से बाहर है।</string>
    <string name="rule_gap">नियम: इस तरह का हाल का कोई रिकॉर्ड नहीं मिला।</string>
    <string name="rule_medicine">नियम: आपकी दवाइयों की सूची और रिमाइंडर में दर्ज खुराकों पर आधारित।</string>
    <string name="rule_followup">नियम: किसी इलाज की फ़ॉलो-अप तारीख़ पास है या निकल गई है।</string>
    <string name="rule_wearable">नियम: इस हफ़्ते के Health Connect के रोज़ के औसत की तुलना पिछले चार हफ़्तों से की गई।</string>
    <string name="score_breakdown">हेल्थ स्कोर कैसे निकाला गया</string>
    <string name="score_explain">स्कोर चार हिस्सों को जोड़ता है। जिन हिस्सों का डेटा नहीं है वे छोड़ दिए जाते हैं और बाकी को बढ़ाया जाता है, ताकि कमी आपके पक्ष या विरोध में न गिनी जाए। 40%% से कम जानकारी होने पर स्कोर नहीं दिखता।</string>
